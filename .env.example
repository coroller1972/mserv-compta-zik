# Compta uniquement : aucune clé privée ni variable de signature ici.
# Pour toute la pile Compose, utiliser ../.env.example.
# Identity : ../mserv-identity/.env.example ; déploiement : deploy.yml.
# Trusted Identity base URL; /session and /.well-known/jwks.json are appended.
AUTH_IDENTITY_URL=http://mserv-identity:8083/api/auth
# Use exactly the same issuer and audience as the ES256 Identity deployment.
AUTH_JWT_ISSUER=identity-auth
AUTH_JWT_AUDIENCE=identity-api
